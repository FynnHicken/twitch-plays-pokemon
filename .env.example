# Twitch Plays Pokemon - Umgebungsvariablen Konfiguration

# Port für das Webinterface (Standard: 8000)
PORT=8000

# Bildwiederholrate des Web-Videostreams (Standard: 30)
FPS=30

# Standard-Modus: 'anarchy' oder 'democracy'
DEFAULT_MODE=anarchy

# Sekunden pro Abstimmungsrunde im Demokratie-Modus (Standard: 10)
DEMOCRACY_INTERVAL=10

# Prozentualer Schwellenwert für Demokratie-Umschaltung (0.6 = 60%)
DEMOCRACY_THRESHOLD=0.6

# Intervall für automatische Save-States in Sekunden
AUTO_SAVE_INTERVAL=60

# Optional: Spezifischer Pfad zu einer ROM-Datei (falls leer, wird der Ordner /app/roms durchsucht)
# ROM_PATH=/app/roms/pokemon_red.gb

# ==========================================
# OPTIONALE ECHTE TWITCH INTEGRATION
# ==========================================
# Dein Twitch-Kanalname (ohne #). Wenn gesetzt, liest der Bot live den Chat deines Twitch-Streams!
# Hinweis: Auch ohne OAuth Token kann der Bot anonym mitlesen (justinfan).
# TWITCH_CHANNEL=dein_twitch_kanal

# Optional: OAuth Token für Bot-Antworten (von https://twitchapps.com/tmi/)
# TWITCH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxx

# Optional: Bot Nickname (falls ein eigener Bot-Account genutzt werden soll)
# TWITCH_NICK=dein_bot_name
